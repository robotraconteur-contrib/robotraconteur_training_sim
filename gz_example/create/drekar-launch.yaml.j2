name: rr_training_sim_create
tasks:
  - name: gz_sim
    program: gz
    args: sim -s -r --wait-for-assets=1 create_world.world
    cwd: {{ configdir }}
    environment:
      {% if platform == "win32" %}
      GZ_SIM_RESOURCE_PATH: {{ env.get("GZ_SIM_RESOURCE_PATH","") }};{{ configdir }}/../models
      {% else %}
      GZ_SIM_RESOURCE_PATH: {{ env.get("GZ_SIM_RESOURCE_PATH","") }}:{{ configdir }}/../models
      {% endif %}
    quit-on-terminate: true
  - name: gz_gui
    program: gz
    args: sim -g --gui-config gz_gui.config
    cwd: {{ configdir }}
    environment:
      {% if platform == "win32" %}
      GZ_SIM_RESOURCE_PATH: {{ env.get("GZ_SIM_RESOURCE_PATH", "") }};{{ configdir }}/../models
      {% else %}
      GZ_SIM_RESOURCE_PATH: {{ env.get("GZ_SIM_RESOURCE_PATH", "") }}:{{ configdir }}/../models
      {% endif %}
    quit-on-terminate: true
  - name: create_driver
    program: python
    args: gazebo_irobot_create_service.py
    cwd: {{ configdir }}
    start-delay: 5
  - name: webcam_driver
    program: python
    args: gazebo_simple_webcam_service.py
    cwd: {{ configdir }}
    start-delay: 5

