    </include>

    <include>
      <uri>model://round_bottle</uri>
      <name>round_bottle_3</name>
      <pose>-0.55 0.75 1.1 0 0 0</pose>
    </include>

    <include>
      <uri>model://round_bottle</uri>
      <name>round_bottle_4</name>
      <pose>-0.65 0.75 1.1 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://cube200</uri>
      <name>cube200_1</name>
      <pose>-0.55 0.425 1.1 0 0 0</pose>
    </include>

    <include>
      <uri>model://cube200</uri>
      <name>cube200_2</name>
      <pose>-0.65 0.425 1.1 0 0 0</pose>
    </include>

    <include>
      <uri>model://cube200</uri>
      <name>cube200_3</name>
      <pose>-0.55 0.525 1.1 0 0 0</pose>
    </include>

    <include>
      <uri>model://cube200</uri>
      <name>cube200_4</name>
      <pose>-0.65 0.525 1.1 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://perfume</uri>
      <name>perfume_1</name>
      <pose>0.55 0.65 1.1 0 0 0</pose>
    </include>

    <include>
      <uri>model://perfume</uri>
      <name>perfume_2</name>
      <pose>0.65 0.65 1.1 0 0 0</pose>
    </include>

    <include>
