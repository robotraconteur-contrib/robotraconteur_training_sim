      <pose>0.65 0.75 1.1 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://cube201</uri>
      <name>cube201_1</name>
      <pose>0.55 0.425 1.1 0 0 0</pose>
    </include>

    <include>
      <uri>model://cube201</uri>
      <name>cube201_2</name>
      <pose>0.65 0.425 1.1 0 0 0</pose>
    </include>

    <include>
      <uri>model://cube201</uri>
      <name>cube201_3</name>
      <pose>0.55 0.525 1.1 0 0 0</pose>
    </include>

    <include>
      <uri>model://cube201</uri>
      <name>cube201_4</name>
      <pose>0.65 0.525 1.1 0 0 0</pose>
    </include>

    <gravity>
      0.0 0.0 -9.81
    </gravity>
    
  </world>
</sdf>
